dns://node.local {
    log
    errors
    ready
    reload
    loadbalance
    header {
        response set ra
    }
    etcd node.local {
        fallthrough
        endpoint http://127.0.0.1:2379
    }
    forward node.local 1.1.1.1
}
dns://. {
    errors
    ready
    reload
    loadbalance
    cache
    forward . 1.1.1.1 1.0.0.1
}
